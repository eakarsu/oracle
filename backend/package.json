{
  "name": "oracle-procurement-backend",
  "version": "1.0.0",
  "description": "Bounded procurement approval API retained from the Oracle ERP prototype",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check:config": "node scripts/check-config.js",
    "check:ready": "node scripts/check-ready.js",
    "migrate": "node migrations/run.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "create-admin": "node scripts/bootstrap-admin.js",
    "provision:user": "node scripts/provision-user.js",
    "check:syntax": "find . -path ./node_modules -prune -o -name '*.js' -exec node --check {} +",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
