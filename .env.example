# Required. Use a dedicated least-privilege PostgreSQL role and database.
DATABASE_URL=postgresql://oracle_app:replace-me@127.0.0.1:5432/oracle_procurement

# Required. Generate a random value with at least 32 characters; never reuse this example.
JWT_SECRET=replace-with-at-least-32-random-characters

# Exact comma-separated browser origins. Production origins must use HTTPS.
CORS_ORIGINS=http://127.0.0.1:3000

NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
FRONTEND_PORT=3000
DATABASE_SSL=false
TRUST_PROXY=false

# Optional JWT metadata. Changing either invalidates existing sessions.
JWT_ISSUER=oracle-procurement
JWT_AUDIENCE=oracle-procurement-web
ACCESS_TOKEN_TTL=15m
